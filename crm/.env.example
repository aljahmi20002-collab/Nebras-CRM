# NebrasCRM production configuration
# Generate each secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CRM_ENV=production
CRM_SECRET=replace-with-a-unique-32-plus-character-secret
CRM_PORTAL_SECRET=replace-with-a-different-32-plus-character-secret
CRM_AGENT_PORTAL_SECRET=replace-with-a-different-32-plus-character-secret
CRM_WEBHOOK_SECRET=replace-with-a-different-32-plus-character-secret

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave unset when the UI and API share one origin.
CRM_CORS_ORIGINS=https://crm.example.com

# Database engine: sqlite (default), mariadb, or postgresql.
CRM_DB_ENGINE=sqlite

# SQLite only — optional persistent location. Default: crm/crm.db
CRM_DB_PATH=/var/lib/nebrascrm/crm.db

# MariaDB / MySQL — use .env.mariadb.example for MariaDB or CRM_DB_ENGINE=mysql for MySQL.
# CRM_DB_ENGINE=mariadb
# CRM_DB_ENGINE=mysql
# CRM_DB_HOST=127.0.0.1
# CRM_DB_PORT=3306
# CRM_DB_NAME=nebrascrm
# CRM_DB_USER=nebrascrm
# CRM_DB_PASSWORD=replace-with-a-strong-database-password
# CRM_DB_CHARSET=utf8mb4

# PostgreSQL only — see .env.postgresql.example for a complete template.
# CRM_DB_ENGINE=postgresql
# CRM_DB_HOST=127.0.0.1
# CRM_DB_PORT=5432
# CRM_DB_NAME=nebrascrm
# CRM_DB_USER=nebrascrm
# CRM_DB_PASSWORD=replace-with-a-strong-database-password
# CRM_DB_SSLMODE=prefer

# Optional only behind a trusted reverse proxy that sanitizes X-Forwarded-For.
CRM_TRUST_PROXY_HEADERS=false

# Optional Resend fallback. The UI can store a Resend key too, but an environment
# variable is preferable for a production secret. Select Resend in Email → Delivery settings.
# CRM_RESEND_API_KEY=re_replace_with_your_resend_key

# Optional token lifetimes in seconds (default: 28800 / 8 hours)
# CRM_TOKEN_TTL_SECONDS=28800
# CRM_PORTAL_TOKEN_TTL_SECONDS=28800
# CRM_AGENT_TOKEN_TTL_SECONDS=28800
