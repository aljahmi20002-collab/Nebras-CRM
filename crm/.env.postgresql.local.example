# Native/local PostgreSQL connection for run-postgresql-local.sh.
# Copy to .env.postgresql.local, set a strong password, then chmod 600 it.
export CRM_DB_ENGINE=postgresql
export CRM_DB_HOST=127.0.0.1
export CRM_DB_PORT=5432
export CRM_DB_NAME=nebrascrm
export CRM_DB_USER=nebrascrm
export CRM_DB_PASSWORD='replace-with-a-strong-database-password'
export CRM_DB_SSLMODE=prefer
