@echo off
rem Native/local PostgreSQL connection for run-postgresql-local.bat.
rem Copy this file to .env.postgresql.local.bat and replace the password.
rem Do not commit the copied file.

set "CRM_DB_ENGINE=postgresql"
set "CRM_DB_HOST=127.0.0.1"
set "CRM_DB_PORT=5432"
set "CRM_DB_NAME=nebrascrm"
set "CRM_DB_USER=nebrascrm"
set "CRM_DB_PASSWORD=replace-with-a-strong-database-password"
set "CRM_DB_SSLMODE=prefer"
