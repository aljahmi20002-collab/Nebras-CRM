@echo off
rem Native/local MariaDB connection for run-mariadb-local.bat.
rem Copy this file to .env.mariadb.local.bat and replace the password.
rem Do not commit the copied file.

set "CRM_DB_ENGINE=mariadb"
set "CRM_DB_HOST=127.0.0.1"
set "CRM_DB_PORT=3306"
set "CRM_DB_NAME=nebrascrm"
set "CRM_DB_USER=nebrascrm"
set "CRM_DB_PASSWORD=replace-with-a-strong-database-password"
set "CRM_DB_CHARSET=utf8mb4"
