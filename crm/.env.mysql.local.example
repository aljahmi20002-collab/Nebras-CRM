# Native/local MySQL connection for run-mysql.sh.
# MySQL and MariaDB use the same supported PyMySQL dialect in NebrasCRM.
# Copy to .env.mysql.local, set the password, then chmod 600 it.
export CRM_DB_ENGINE=mysql
export CRM_DB_HOST=127.0.0.1
export CRM_DB_PORT=3306
export CRM_DB_NAME=nebrascrm
export CRM_DB_USER=nebrascrm
export CRM_DB_PASSWORD='replace-with-a-strong-database-password'
export CRM_DB_CHARSET=utf8mb4
