# Docker PostgreSQL and NebrasCRM connection values.
# Copy this file to .env.postgresql and replace POSTGRES_PASSWORD / CRM_DB_PASSWORD.
POSTGRES_DB=nebrascrm
POSTGRES_USER=nebrascrm
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432
TZ=UTC

# NebrasCRM application connection values
CRM_DB_ENGINE=postgresql
CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=5432
CRM_DB_NAME=nebrascrm
CRM_DB_USER=nebrascrm
CRM_DB_PASSWORD=replace-with-a-strong-database-password
CRM_DB_SSLMODE=prefer
