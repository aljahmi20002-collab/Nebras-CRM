# NebrasCRM Docker Compose configuration.
# compose-up.sh creates .env.docker with secure random local values if it is absent.
# For shared or production deployments, replace every generated secret/password.

NEBRAS_PORT=8008
CRM_ENV=production
CRM_SECRET=replace-with-a-unique-32-plus-character-secret
CRM_PORTAL_SECRET=replace-with-a-different-32-plus-character-secret
CRM_AGENT_PORTAL_SECRET=replace-with-a-different-32-plus-character-secret
CRM_WEBHOOK_SECRET=replace-with-a-different-32-plus-character-secret
# Created once on the first empty MySQL database; it never resets an existing user.
CRM_BOOTSTRAP_ADMIN_EMAIL=admin@nebrascrm.local
CRM_BOOTSTRAP_ADMIN_NAME=NebrasCRM Administrator
CRM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-admin-password
CRM_CORS_ORIGINS=
CRM_RESEND_API_KEY=

MYSQL_DATABASE=nebrascrm
MYSQL_USER=nebrascrm
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
