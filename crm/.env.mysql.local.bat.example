@echo off
rem Native/local MySQL connection for run-mysql.bat.
rem Copy this file to .env.mysql.local.bat and replace the password.
rem MySQL and MariaDB are both supported through the MySQL-compatible driver.

set "CRM_DB_ENGINE=mysql"
set "CRM_DB_HOST=127.0.0.1"
set "CRM_DB_PORT=3306"
set "CRM_DB_NAME=nebrascrm"
set "CRM_DB_USER=nebrascrm"
set "CRM_DB_PASSWORD=replace-with-a-strong-database-password"
set "CRM_DB_CHARSET=utf8mb4"
