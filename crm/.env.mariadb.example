# Copy this file to .env.mariadb and replace both passwords.
MARIADB_DATABASE=nebrascrm
MARIADB_USER=nebrascrm
MARIADB_PASSWORD=replace-with-a-strong-database-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-strong-root-password
MARIADB_PORT=3306
TZ=UTC

# NebrasCRM application connection values
CRM_DB_ENGINE=mariadb
CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=3306
CRM_DB_NAME=nebrascrm
CRM_DB_USER=nebrascrm
CRM_DB_PASSWORD=replace-with-a-strong-database-password
CRM_DB_CHARSET=utf8mb4
